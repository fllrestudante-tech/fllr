# Copie para .env e preencha com suas chaves da Bybit (permissão: Contract Trading apenas, SEM saque/withdraw)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true = Demo Trading (api-demo.bybit.com) — conta de teste isolada do site principal.
# A chave precisa ser gerada especificamente em Demo Trading (não reaproveita chave de testnet/mainnet).
BYBIT_DEMO=true

# true = api-testnet.bybit.com (só usado se BYBIT_DEMO=false) | false = api.bybit.com (dinheiro real)
BYBIT_TESTNET=false

# Símbolo do par (USDT Perpétuo linear)
SYMBOL=SOLUSDT

# Intervalo dos candles (minutos): 1, 3, 5, 15, ...
INTERVAL=1

# Alavancagem máxima permitida
LEVERAGE_MAX=5

# % do equity real arriscado por trade (ex: 0.01 = 1%)
RISK_PER_TRADE_PCT=0.01

# % de perda diária acumulada que interrompe novas entradas (ex: 0.05 = 5%)
DAILY_LOSS_LIMIT_PCT=0.05

# Alvo de retorno por trade sobre a margem alocada (ex: 0.06 = 6%)
TARGET_RETURN_PER_TRADE_PCT=0.06

# De quantas em quantas horas o auto-tuning roda
BACKTEST_INTERVAL_HOURS=6

# De quanto em quanto tempo (ms) os health checks de cada módulo rodam
HEALTH_CHECK_INTERVAL_MS=60000

# --- Alertas críticos (lib/alerts.js) ---
# Crie um bot separado via @BotFather no Telegram (gratuito) só pra alertas.
# Mande /start pro bot e use https://api.telegram.org/bot<TOKEN>/getUpdates
# pra descobrir seu chat_id.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- Knowledge Collector: eventos de mercado (Fase 0.3) ---
# CoinMarketCal: cadastro grátis em https://coinmarketcal.com/en/api
COINMARKETCAL_API_KEY=
# FRED: chave grátis instantânea em https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- AI Gateway: participa da análise do loop de trading em SHADOW MODE
# (gera e audita AI Assessment a cada ciclo relevante, NUNCA executa ordens
# nem influencia lib/risk.js -- ver lib/aiGateway/aiGateway.js) ---
# OpenAI (provider secundário/fallback econômico) -- https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-5.6-luna (migrado 2026-08-13 de gpt-4o-mini, após teste comparativo real
# -- ver commit deste arquivo): família reasoning, não aceita temperature
# customizada, usa OPENAI_REASONING_EFFORT abaixo em vez disso.
OPENAI_MODEL=gpt-5.6-luna
# "none" evita gastar tokens de raciocínio ocultos -- só vale pra modelos
# gpt-5.x (família reasoning); ignorado se OPENAI_MODEL virar gpt-4o-mini de
# novo. Valores aceitos: none | low | medium | high | xhigh | max.
OPENAI_REASONING_EFFORT=none
# Anthropic (provider primário/oficial) -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Haiku 3.5 retirado da Claude API de primeira parte (retirada confirmada em 2026-08-14).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Ordem de tentativa primário -> secundário. Anthropic é a base principal do
# Crypto10 (referência do acompanhamento do sistema); OpenAI (gpt-5.6-luna) é
# o laboratório econômico/fallback -- troque só se quiser inverter a prioridade.
AI_PRIMARY_PROVIDER=anthropic
AI_SECONDARY_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=20000
# 500 -> 2000 (2026-08-13): gpt-5.6-luna produz respostas mais analíticas
# (986 tokens observados em teste real) -- 500 arriscava truncar o JSON.
AI_MAX_OUTPUT_TOKENS=2000
# Fase 2 (AI Shadow Evaluation, scripts/aiShadowEvaluator.js) -- cadência do
# tick de observação (15min por padrão, casado com o slow tier do metricsSampler).
# Reaproveitado também como teto/heartbeat do AI Decision Cycle do loop de trading.
AI_SHADOW_INTERVAL_MS=900000
# AI Decision Cycle (lib/aiGateway/decisionCyclePolicy.js) -- piso mínimo entre
# chamadas de IA disparadas pelo loop de trading (10s), mesmo com sinal
# quantitativo repetindo tick a tick. Controle de custo.
AI_MIN_CALL_INTERVAL_MS=300000

# AgentRouter (provider primário na ordem atual: agentrouter -> anthropic ->
# openai, ver config.js::parseProviderOrder) -- transporte via subprocesso
# Codex CLI oficial (lib/agentrouterClient.js), não HTTP direto. A API key em
# si NUNCA é lida por essas variáveis nem por nenhum outro ponto do processo
# do bot -- autenticação mora exclusivamente em ~/.codex/config.toml, gerida
# pelo próprio Codex CLI (`codex login`). Estas 4 variáveis só configuram
# *como* o subprocesso é invocado, não *quem* ele é.
# Nome/caminho do binário do Codex CLI. Default "codex" resolve via PATH em
# Linux/macOS, mas no Windows o `spawn(..., {shell:false})` do Node NÃO
# resolve o shim `codex.cmd` do npm -- aponte para o codex.exe real (ex.:
# rode `codex doctor` e use o campo "executable"). Não aceita shim .cmd/.bat.
AGENTROUTER_CODEX_COMMAND=codex
# Modelo pedido ao AgentRouter (validado nos testes desta integração).
AGENTROUTER_MODEL=gpt-5.6-sol
# Timeout total da chamada (subprocesso Codex CLI), em ms.
AGENTROUTER_TIMEOUT_MS=60000
# Prazo de graça pro subprocesso encerrar sozinho antes de kill forçado, em ms.
AGENTROUTER_GRACEFUL_SHUTDOWN_MS=5000

# --- Radar de Telegram (telegram-radar/) ---
# Gere em https://my.telegram.org (API development tools). É diferente de bot token.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Preenchido automaticamente por telegram-radar/login.js após o login único.
TELEGRAM_SESSION=
# Nomes de canais a escutar, separados por vírgula (precisam bater com o título exato no Telegram).
TELEGRAM_CHANNELS=Velatrader Squad Oficial
